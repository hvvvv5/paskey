import React, { useCallback, useEffect, useMemo, useState } from 'react';
import { Link } from 'react-router-dom';
import {
  CheckCircle2,
  Download,
  Globe2,
  KeyRound,
  Plus,
  RefreshCw,
  Search,
  Smartphone,
  UserRound,
} from 'lucide-react';
import { useVault } from '@/components/paskey/VaultContext';
import { syncAutofillVault } from '@/lib/native/syncAutofillVault';

function loginTitle(item) {
  return item.title || item.website || item.applicationIdentifier || 'Saved login';
}

function loginTarget(item) {
  return item.website || item.applicationIdentifier || 'Local login';
}

function loginIdentity(item) {
  return item.username || item.email || 'No username saved';
}

export default function Autofill() {
  const { repo, dec } = useVault();
  const [items, setItems] = useState([]);
  const [query, setQuery] = useState('');
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const importSavedLogins = useCallback(async () => {
    if (!repo) {
      setItems([]);
      setLoading(false);
      return;
    }

    setLoading(true);
    setError('');

    try {
      await syncAutofillVault(repo, dec);
      setItems(await repo.listCategory('passwords'));
    } catch (e) {
      console.error('PasKey Autofill import error:', e);
      setError('Could not import saved logins. Try again after unlocking PasKey.');
    } finally {
      setLoading(false);
    }
  }, [repo, dec]);

  useEffect(() => {
    importSavedLogins();
  }, [importSavedLogins]);

  const filtered = useMemo(() => {
    const needle = query.trim().toLowerCase();

    if (!needle) return items;

    return items.filter((item) => {
      const text = [
        item.title,
        item.website,
        item.applicationIdentifier,
        item.username,
        item.email,
      ].join(' ').toLowerCase();

      return text.includes(needle);
    });
  }, [items, query]);

  return (
    <div className="px-5 pb-28 pt-5">
      <div className="flex items-start justify-between gap-4">
        <div>
          <p className="text-xs uppercase tracking-[0.24em] text-[#C8A96B]">PasKey Autofill</p>
          <h1 className="mt-2 font-heading text-3xl text-white">Saved Logins</h1>
          <p className="mt-2 text-sm text-[#AEB4BE]">
            Store and manage sign-ins for websites and Android apps.
          </p>
        </div>

        <Link
          to="/new/passwords"
          className="inline-flex shrink-0 items-center gap-2 rounded-xl bg-[#C8A96B] px-3 py-2 text-sm font-medium text-[#070707] active:scale-95"
        >
          <Plus className="h-4 w-4" />
          Save
        </Link>
      </div>

      <section className="mt-6 rounded-2xl border border-[#C8A96B]/30 bg-gradient-to-br from-[#C8A96B]/10 to-white/[0.03] p-4">
        <div className="flex gap-3">
          <div className="rounded-xl bg-[#C8A96B]/15 p-3 text-[#C8A96B]">
            <CheckCircle2 className="h-5 w-5" />
          </div>
          <div className="min-w-0 flex-1">
            <p className="font-medium text-white">Autofill save is ready</p>
            <p className="mt-1 text-sm text-[#AEB4BE]">
              After a supported login, approve Android's save prompt, then import it here.
            </p>
          </div>
        </div>

        <button
          type="button"
          onClick={importSavedLogins}
          disabled={loading}
          className="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-[#C8A96B]/50 px-4 py-3 text-sm font-medium text-[#C8A96B] disabled:opacity-60"
        >
          {loading ? <RefreshCw className="h-4 w-4 animate-spin" /> : <Download className="h-4 w-4" />}
          {loading ? 'Importing saved logins...' : 'Import saved login'}
        </button>
      </section>

      <div className="relative mt-6">
        <Search className="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#AEB4BE]" />
        <input
          value={query}
          onChange={(event) => setQuery(event.target.value)}
          placeholder="Search saved logins"
          className="w-full rounded-2xl border border-white/10 bg-white/[0.04] py-3 pl-11 pr-4 text-sm text-white outline-none placeholder:text-[#AEB4BE] focus:border-[#C8A96B]/60"
        />
      </div>

      <div className="mt-4 flex items-center justify-between text-xs text-[#AEB4BE]">
        <span>{filtered.length} saved {filtered.length === 1 ? 'login' : 'logins'}</span>
        <span>Passwords hidden</span>
      </div>

      {error ? (
        <p className="mt-4 rounded-xl border border-red-400/30 bg-red-400/10 p-3 text-sm text-red-200">{error}</p>
      ) : null}

      <div className="mt-4 space-y-3">
        {!loading && filtered.length === 0 ? (
          <div className="rounded-2xl border border-dashed border-white/15 bg-white/[0.03] p-6 text-center">
            <KeyRound className="mx-auto h-8 w-8 text-[#C8A96B]" />
            <p className="mt-4 text-base text-white">No saved logins yet</p>
            <p className="mt-2 text-sm text-[#AEB4BE]">
              Save one manually or approve Android's Autofill save prompt after signing in.
            </p>
            <Link
              to="/new/passwords"
              className="mt-5 inline-flex items-center gap-2 rounded-xl border border-[#C8A96B]/50 px-4 py-2 text-sm text-[#C8A96B]"
            >
              <Plus className="h-4 w-4" />
              Save a login
            </Link>
          </div>
        ) : (
          filtered.map((item) => (
            <Link
              key={item.id}
              to={`/item/passwords/${item.id}`}
              className="block rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition-colors hover:border-[#C8A96B]/45"
            >
              <div className="flex items-start gap-3">
                <div className="rounded-xl bg-[#C8A96B]/10 p-3 text-[#C8A96B]">
                  {item.website ? <Globe2 className="h-5 w-5" /> : <Smartphone className="h-5 w-5" />}
                </div>
                <div className="min-w-0 flex-1">
                  <p className="truncate font-medium text-white">{loginTitle(item)}</p>
                  <p className="mt-1 truncate text-sm text-[#AEB4BE]">{loginTarget(item)}</p>
                  <div className="mt-3 flex items-center gap-2 text-xs text-[#AEB4BE]">
                    <UserRound className="h-3.5 w-3.5" />
                    <span className="truncate">{loginIdentity(item)}</span>
                  </div>
                </div>
                <KeyRound className="mt-1 h-4 w-4 shrink-0 text-[#AEB4BE]" />
              </div>
            </Link>
          ))
        )}
      </div>
    </div>
  );
}