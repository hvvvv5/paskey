package com.paskey.vault.autofill;

import android.app.assist.AssistStructure;
import android.app.PendingIntent;
import android.content.Intent;
import android.content.IntentSender;
import android.os.CancellationSignal;
import android.service.autofill.AutofillService;
import android.service.autofill.Dataset;
import android.service.autofill.FillCallback;
import android.service.autofill.FillContext;
import android.service.autofill.FillRequest;
import android.service.autofill.FillResponse;
import android.service.autofill.SaveCallback;
import android.service.autofill.SaveRequest;
import android.text.InputType;
import android.view.autofill.AutofillId;
import android.view.autofill.AutofillValue;
import android.widget.RemoteViews;
import android.util.Log;
import android.util.Pair;
import java.util.List;

public class PasKeyAutofillService extends AutofillService {

    private AutofillId usernameId;
    private AutofillId passwordId;
    private AutofillId phoneId;
    private AutofillId cardholderId;
    private AutofillId cardNumberId;
    private AutofillId cardExpiryId;
    private AutofillId cardCvvId;
    private String targetPackage = "";
    private String targetWebDomain = "";

    @Override
    public void onFillRequest(
            FillRequest request,
            CancellationSignal cancelationSignal,
            FillCallback callback) {

        Log.d("PasKeyAutofill", "onFillRequest called");

        usernameId = null;
        passwordId = null;
        phoneId = null;
        cardholderId = null;
        cardNumberId = null;
        cardExpiryId = null;
        cardCvvId = null;
        targetWebDomain = "";

        if (request.getFillContexts() == null ||
                request.getFillContexts().isEmpty()) {
            callback.onSuccess(null);
            return;
        }

        FillContext context =
                request.getFillContexts()
                        .get(request.getFillContexts().size() - 1);

        AssistStructure structure = context.getStructure();

        targetPackage = "";
        if (structure.getActivityComponent() != null) {
            targetPackage = structure.getActivityComponent().getPackageName();
       }

        for (int i = 0; i < structure.getWindowNodeCount(); i++) {
            AssistStructure.WindowNode window =
                    structure.getWindowNodeAt(i);

            findFields(window.getRootViewNode());
        }

        if (usernameId == null &&passwordId == null && phoneId == null) {
            callback.onSuccess(null);
            return;
        }

        org.json.JSONArray items;

        try {
            items = PasKeyAutofillStore.load(this);
        } catch (Exception e) {
            Log.e("PasKeyAutofill", "Unable to load secure Autofill vault", e);
            callback.onSuccess(null);
            return;
        }

        if (items.length() == 0) {
            callback.onSuccess(null);
            return;
        }

        FillResponse.Builder responseBuilder =
                new FillResponse.Builder();

        int datasetCount = 0;

        for (int i= 0; i < items.length(); i++) {
            org.json.JSONObject item = items.optJSONObject(i);

            if (item == null) {
                continue;
            }

            String category = item.optString("category", "");

            if ("cards".equals(category)) {
                continue;
            }

            String username = item.optString("username", "");

            if (username.isEmpty()) {
                username = item.optString("email", "");
            }

            String phone = item.optString("phone", "");
            String password = item.optString("password", "");

            RemoteViews presentation =
                    new RemoteViews(
                            getPackageName(),
                            android.R.layout.simple_list_item_1
                    );

            String title = item.optString("title", "PasKey");

            if (title.isEmpty()) {
                title = "PasKey";
            }

            presentation.setTextViewText(
                   android.R.id.text1,
                    title
            );

            Dataset.Builder dataset =
                    new Dataset.Builder();

            boolean hasValue = false;

            if (usernameId != null && !username.isEmpty()) {
                dataset.setValue(
                        usernameId,
                        AutofillValue.forText(username),
                        presentation
                );
                hasValue = true;
            }

            if (phoneId !=null && !phone.isEmpty()) {
                dataset.setValue(
                        phoneId,
                        AutofillValue.forText(phone),
                        presentation
                );
                hasValue = true;
            }

            if (passwordId != null && !password.isEmpty()) {
                dataset.setValue(
                        passwordId,
                        AutofillValue.forText(password),
                        presentation
                );
               hasValue = true;
            }

            if (hasValue) {
                responseBuilder.addDataset(dataset.build());
                datasetCount++;
            }
        }

        if (datasetCount == 0) {
            callback.onSuccess(null);
            return;
        }

        callback.onSuccess(responseBuilder.build());
    }

    private void findFields(AssistStructure.ViewNode node) {
        if (node == null) {
            return;
        }

        AutofillId id = node.getAutofillId();

        String webDomain = node.getWebDomain();
        if (webDomain != null && !webDomain.isEmpty()) {
            targetWebDomain = webDomain.toLowerCase(java.util.Locale.ROOT);
       }

        if (id != null) {
            String text = "";

            if (node.getHint() != null) {
                text += " " + node.getHint();
            }

            if (node.getIdEntry() != null) {
                text += " " + node.getIdEntry();
            }

            String[] hints = node.getAutofillHints();

            if (hints != null) {
                for (String hint : hints) {
                    if (hint != null) {
                        text += " " + hint;
                    }
               }
            }

            Log.d("PasKeyAutofill", "FIELD class=" + node.getClassName() + " hint=" + node.getHint() + " id=" + node.getIdEntry() + " autofillHints=" + java.util.Arrays.toString(node.getAutofillHints()));

            if (node.getHtmlInfo() != null) {
                android.view.ViewStructure.HtmlInfo htmlInfo = node.getHtmlInfo();

                if (htmlInfo.getTag() != null) {
                    text += " " + htmlInfo.getTag();
                }

                List<Pair<String, String>> attributes =
                        htmlInfo.getAttributes();

                if (attributes != null) {
                    for (Pair<String, String> attribute : attributes) {
                        if (attribute.first != null) {
                           text += " " + attribute.first;
                        }

                        if (attribute.second != null) {
                            text += " " + attribute.second;
                        }
                    }
                }
            }

            text = text.toLowerCase();

            int inputType = node.getInputType();
            int inputClass = inputType & InputType.TYPE_MASK_CLASS;
            int inputVariation = inputType & InputType.TYPE_MASK_VARIATION;

            if(inputClass == InputType.TYPE_CLASS_PHONE) {
                text += " phone";
            }

            if (inputVariation == InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS ||
                    inputVariation == InputType.TYPE_TEXT_VARIATION_WEB_EMAIL_ADDRESS) {
                text += " email";
            }

            if (inputVariation == InputType.TYPE_TEXT_VARIATION_PASSWORD ||
                    inputVariation == InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD ||
                    inputVariation == InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD ||
                    inputVariation == InputType.TYPE_NUMBER_VARIATION_PASSWORD) {
                text += " password";
            }

            if (cardNumberId == null &&
                    (text.contains("creditcardnumber") ||
                    text.contains("credit_card_number") ||
                     text.contains("cardnumber") ||
                     text.contains("card_number") ||
                     text.contains("cc-number") ||
                     text.contains("cc_number"))) {

                cardNumberId = id;

            } else if (cardExpiryId == null &&
                    (text.contains("cc-exp") ||
                     text.contains("expiry") ||
                     text.contains("expiration") ||
                    text.contains("exp-date") ||
                     text.contains("exp_date") ||
                     text.contains("mm/yy") ||
                     text.contains("mm/yyyy"))) {

                cardExpiryId = id;

            } else if (cardCvvId == null &&
                    (text.contains("cvv") ||
                     text.contains("cvc") ||
                     text.contains("securitycode") ||
                     text.contains("security_code") ||
                     text.contains("cc-csc"))) {
                cardCvvId = id;

            } else if (cardholderId == null &&
                    (text.contains("cardholder") ||
                     text.contains("card_holder") ||
                     text.contains("nameoncard") ||
                     text.contains("name_on_card") ||
                     text.contains("cc-name"))) {

                cardholderId = id;

            } else if (passwordId == null &&
                    (text.contains("password") ||
                     text.contains("passwd") ||
                     text.contains("passcode"))) {

                passwordId = id;

            } else if (phoneId == null &&
                    (text.contains("phone") ||
                     text.contains("telephone") ||
                     text.contains("mobile") ||
                     text.contains("phone_number") ||
                     text.contains("phonenumber"))) {

                phoneId = id;

            } else if (usernameId == null &&
                    (text.contains("uername") ||
                     text.contains("user") ||
                     text.contains("email") ||
                     text.contains("login") ||
                     text.contains("userid") ||
                     text.contains("user_id") ||
                     text.contains("customerid") ||
                     text.contains("customer_id") ||
                     text.contains("accountid") ||
                     text.contains("account_id"))) {

                usernameId = id;
            }
       }
        for (int i = 0; i < node.getChildCount(); i++) {
            findFields(node.getChildAt(i));
        }
    }

    @Override
    public void onSaveRequest(
            SaveRequest request,
            SaveCallback callback) {

        callback.onSuccess();
    }
}

